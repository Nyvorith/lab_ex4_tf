  "captions": [
    {
      "picture": "PIC1.BMP",
      "text_file": "assets/exhibition/narration/AUDIO1.txt",
      "artwork_label": [
        "埃特勒塔的大拱门",
        "克劳德·莫奈 1882"
      ],
      "preview_lookpoint": "光影初见：留意岩岸明暗与海面色彩",
      "text": "欢迎来到光与色的名画之旅。第一站，光影初见，欣赏莫奈的埃特勒塔的大拱门。请留意岩岸的明暗变化，以及海面蓝绿交织的色彩，看看画家怎样用光线表现自然。",
      "picture_index": 0,
      "length": 73,
      "width_px": 1168
    },
    {
      "picture": "PIC2.BMP",
      "text_file": "assets/exhibition/narration/AUDIO2.txt",
      "artwork_label": [
        "神奈川冲浪里",
        "葛饰北斋 约1830-1832"
      ],
      "preview_lookpoint": "浪潮律动：比较近处巨浪与远方富士山",
      "text": "第二站，浪潮律动，欣赏北斋的神奈川冲浪里。巨浪卷起，小船在浪间前行。请比较近处巨浪与远方富士山，留意弯曲的浪花线条，感受画面中的节奏与力量。",
      "picture_index": 1,
      "length": 70,
      "width_px": 1120
    },
    {
      "picture": "PIC3.BMP",
      "text_file": "assets/exhibition/narration/AUDIO3.txt",
      "artwork_label": [
        "麦田与柏树",
        "文森特·梵高 1889"
      ],
      "preview_lookpoint": "色彩情绪：观察云朵和树木的流动线条",
      "text": "第三站，色彩情绪，来到梵高的麦田与柏树。金黄麦田、深色柏树与蓝色天空，在旋转的笔触中呼应。请留意云朵与树木的流动线条，感受画家如何用色彩表达情绪。",
      "picture_index": 2,
      "length": 73,
      "width_px": 1168
    },
    {
      "picture": "PIC4.BMP",
      "text_file": "assets/exhibition/narration/AUDIO4.txt",
      "artwork_label": [
        "苏格拉底之死",
        "雅克·路易·大卫 1787"
      ],
      "preview_lookpoint": "理性回响：观察人物手势与群像布局",
      "text": "最后一站，理性回响，欣赏大卫的苏格拉底之死。画中人物的手势、明暗与群像布局，引导我们从自然的光与色转向人的思想。请观察苏格拉底举起的手，感受理性与信念的力量。",
      "picture_index": 3,
      "length": 79,
      "width_px": 1264
    }
  ],
